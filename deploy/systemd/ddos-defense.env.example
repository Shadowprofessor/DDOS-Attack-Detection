# /etc/ddos-defense/ddos-defense.env
# Environment configuration template for bare-metal systemd installation
#
# File permissions should be restricted to ddos user:
#   sudo chown ddos:ddos /etc/ddos-defense/ddos-defense.env
#   sudo chmod 600 /etc/ddos-defense/ddos-defense.env

# Environment mode: development, staging, or production
DDOS_ENV=production

# Model directory path
DDOS_MODEL_DIR=/opt/ddos-defense/models

# API Authentication Keys (comma-separated). Leave blank to generate dev keys at startup.
# DDOS_API_KEYS=key1,key2
DDOS_API_KEYS=

# Admin API Keys for Human-in-the-Loop approval gate (/actions/approve, /actions/reject)
# DDOS_ADMIN_KEYS=admin_secret_key
DDOS_ADMIN_KEYS=

# LLM Reasoning Agent (Nemotron via OpenRouter or NVIDIA NIM)
OPENROUTER_API_KEY=
NVIDIA_API_KEY=

# Layer-3 threat analyst (M2) - all optional; defaults shown
# DDOS_LLM_MODELS=nvidia/nemotron-3-ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
# DDOS_LLM_TIMEOUT=90
# DDOS_LLM_ENABLE_THINKING=false
# DDOS_LLM_HASH_IPS=false          # pseudonymise IPs (HMAC) before they reach the LLM
# DDOS_LLM_IP_SALT=                # set for stable pseudonyms across restarts
# DDOS_ANALYST_RATE_PER_MIN=30     # per-API-key analyst calls per minute
# DDOS_LLM_PRICE_IN_PER_1M=0       # USD/1M tokens for cost metrics (0 = free tier)
# DDOS_LLM_PRICE_OUT_PER_1M=0

# Cloudflare Magic Transit Connector (Optional)
# If left unset, Cloudflare mitigation actions operate in proposal-only mode and the stack starts cleanly.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Rate Limiting Configuration
DDOS_RATE_LIMIT_WINDOW=60
DDOS_RATE_LIMIT_MAX=120
DDOS_MAX_BATCH_SIZE=1000
